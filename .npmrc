minimumReleaseAge=0

; Defensive floor for zfb 2.x's bundler, kept in lockstep with the sibling
; zfb example repo.
;
; Mechanism: zfb 2.x runs esbuild over a "shadow tree" whose module resolution
; starts at the PROJECT ROOT, so every bare specifier reachable from the
; page/SSR graph must resolve from `<root>/node_modules`. `hono` is only a
; transitive dep (`@takazudo/zfb-runtime` -> `hono`), and pnpm's default strict
; layout does not link a transitive dep there. Where that bites, `zfb dev`
; fails to bundle `@takazudo/zfb-runtime/dist/router.js` (`Could not resolve
; "hono"`) and silently DEGRADES to "renderer disabled — falling back to empty
; page cache". `zfb build` is unaffected, which is what makes it easy to miss.
;
; Measured here at zfb 2.15.1 (Wave 4): the degradation does NOT reproduce in
; this repo — with this line removed and node_modules rebuilt from scratch,
; `zfb dev` rendered byte-identical HTML and the dev-apply-proxy devMiddleware
; still registered. The entry is kept anyway: it is the narrowest possible fix
; for a failure whose only symptom is a silently empty page cache, and this
; repo has no dev-time check that would catch it. Re-verify before removing.
;
; (This REPLACES pnpm's default public-hoist-pattern of *eslint*/*prettier*;
; neither is used in this project. Changing this setting makes pnpm purge
; node_modules on the next install.)
public-hoist-pattern[]=hono
