{
  "name": "zudo-design-token-panel-example-zfb-tailwind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "zfb 4 + zudo-wind utility example demonstrating @takazudo/zdtp with authored design tokens.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "rm -rf dist .zfb .zfb-build",
    "dev": "node scripts/launch.mjs dev",
    "_dev:zfb": "node scripts/launch.mjs dev:zfb",
    "_dev:tokens-bin": "node scripts/launch.mjs dev:sidecar",
    "build": "zfb build",
    "preview": "node scripts/launch.mjs preview",
    "typecheck": "zfb check",
    "assert:theme-chain": "node scripts/assert-theme-chain.mjs --self-test",
    "test:unit": "node --test \"tests/plugin/*.test.mjs\"",
    "test:e2e": "playwright test",
    "audit:wind": "zfb wind audit --fail-on error"
  },
  "dependencies": {
    "@takazudo/zdtp": "0.5.1",
    "@takazudo/zfb": "4.3.0",
    "@takazudo/zfb-runtime": "4.3.0",
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.4",
    "typescript": "^5.9.3",
    "wrangler": "4.129.0"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.12.34",
      "miniflare>sharp": "0.35.5",
      "miniflare>undici": "7.29.1",
      "concurrently>shell-quote": "1.11.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
