{
  "name": "zudo-design-token-panel-example-zfb-tailwind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "zfb (zudo-front-builder) + Tailwind v4 example demonstrating @takazudo/zdtp — tokens registered via @theme block into Tailwind v4's design-system namespaces, showcase and prose pages styled with utility classes.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "rm -rf dist .zfb .zfb-build zfb-tailwind-entry-*.css",
    "dev": "node scripts/launch.mjs dev",
    "_dev:zfb": "node scripts/launch.mjs dev:zfb",
    "_dev:tokens-bin": "node scripts/launch.mjs dev:sidecar",
    "build": "zfb build",
    "preview": "node scripts/launch.mjs preview",
    "typecheck": "zfb check",
    "assert:theme-chain": "node scripts/assert-theme-chain.mjs --self-test",
    "test:unit": "node --test \"tests/plugin/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@takazudo/zdtp": "0.5.1",
    "@takazudo/zfb": "2.15.1",
    "@takazudo/zfb-runtime": "2.15.1",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.4",
    "typescript": "^5.9.3",
    "wrangler": "4.129.0"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.12.34"
    },
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"]
  }
}
